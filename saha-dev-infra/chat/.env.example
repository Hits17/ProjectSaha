CHAT_SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:REPLACE_WITH_REVIEWED_VERSION
CHAT_ELEMENT_IMAGE=vectorim/element-web:REPLACE_WITH_REVIEWED_VERSION
CHAT_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MATRIX_SERVER_NAME=matrix.example.org
MATRIX_HOMESERVER_URL=https://matrix.example.org
ELEMENT_WEB_URL=https://chat.example.org
