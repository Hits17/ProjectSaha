# Saha Backend — configuration template
#
# Copy to .env and fill in values.
#
# TWO LAYERS OF BOOT VALIDATION (app/core/config.py):
#   validate_security_critical()  runs in EVERY environment, including
#       development. Key material may never be a placeholder — the vault key was
#       found in production set to the literal example value below, which is
#       published in this repository (security/AUDIT.md SAHA-001).
#   validate_production_settings() adds deployment checks for any
#       internet-facing environment (staging AND production).
#
# APP_ENV is a closed set. It used to be a free-form string, and the deployed
# value was `staging` — which matched neither "production" nor "prod", so every
# guard below silently became a no-op on a public host (SAHA-005).

APP_NAME=Saha
APP_ENV=development            # development | staging | production
DEBUG=true                     # MUST be false outside development (also disables /docs)
SECRET_KEY=dev-secret-key-change-in-production   # JWT signing key — generate with: openssl rand -hex 32

# Hosts allowed to reach the API. ["*"] disables the check (development only).
ALLOWED_HOSTS=["*"]

# Reverse-proxy chain. Forwarding headers are honoured ONLY when the socket peer
# falls inside one of these networks. nginx uses $proxy_add_x_forwarded_for,
# which APPENDS, so a client-supplied X-Forwarded-For is attacker-authored —
# see app/core/clientip.py (SAHA-011).
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Database
DATABASE_URL=postgresql+asyncpg://saha:saha@localhost:5432/saha

# Redis — AI dialogue sessions + rate-limit counters + view dedupe.
# Holds creators' invention descriptions in plaintext; keep it loopback-only.
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO dev / any S3-compatible store in prod).
# `minioadmin` is rejected by the boot guard in every environment.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=saha-vault
MINIO_SECURE=false             # true in production (HTTPS)

# Qdrant vector store (semantic discovery; 1024-dim collection).
# Payloads carry teaser-tier fields only — never BOM or private description.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ip_listings
QDRANT_API_KEY=

# Email (Mailpit in dev). SMTP_USE_TLS is required by the boot guard whenever
# SMTP_HOST is not loopback — a remote server carries credentials and message
# bodies, and this was previously hardcoded off (SAHA-027).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=noreply@saha.local

# Multi-provider AI: anthropic | nvidia | ollama | auto
LLM_PROVIDER=nvidia
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=google/diffusiongemma-26b-a4b-it
OLLAMA_BASE_URL=http://localhost:11434

# Data-tier policy for AI calls (SAHA-013). Confidential and trade-secret
# content — BOM authoring dialogue, negotiation messages, contract terms — must
# not leave the trust boundary for third-party inference. Those functions route
# to the self-hosted provider and FAIL CLOSED if it is unreachable.
# Setting this true requires a signed DPA and a documented transfer basis; the
# boot guard refuses it on any internet-facing deployment.
ALLOW_EXTERNAL_LLM_FOR_CONFIDENTIAL=false

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account protection
LOGIN_MAX_ATTEMPTS=5              # failed logins before a temporary lockout
LOGIN_LOCKOUT_MINUTES=15          # lockout duration after the threshold
REQUIRE_EMAIL_VERIFICATION=false  # when true, require_email_verified gates sensitive actions
PASSWORD_MIN_LENGTH=12
MFA_ISSUER=Saha                   # label shown in TOTP authenticator apps

# Administrators without a second factor are refused outright — the console is
# the control plane, so a single stolen password must not be enough (SAHA-015).
# Enrol first: POST /api/v1/auth/mfa/setup then /mfa/enable.
REQUIRE_ADMIN_MFA=true

# Re-authentication for irreversible actions: escrow release, contract
# execution, confidential document egress. The client obtains a token from
# POST /api/v1/auth/step-up and presents it in X-Step-Up-Token.
REQUIRE_STEP_UP_AUTH=true

# Open Innovation Library weekly digest (in-app + email to active members).
LIBRARY_DIGEST_ENABLED=true
LIBRARY_DIGEST_INTERVAL_DAYS=7

# Request body caps (bytes) — enforced by the size-guard middleware
MAX_JSON_BODY_BYTES=1000000      # 1 MB for JSON bodies
MAX_UPLOAD_BYTES=52428800        # 50 MB for multipart uploads (vault assets)

# Cookie-based refresh auth. The refresh token is issued as an httpOnly,
# SameSite cookie so JS can never read it. COOKIE_SECURE MUST be true outside
# development — it was unset (false) on an HTTPS site (SAHA-010).
COOKIE_AUTH_ENABLED=true
COOKIE_SECURE=false              # true outside development
COOKIE_DOMAIN=                   # e.g. .sahasolutions.com in prod; empty = host-only

# Public web app URL — used to build email links. Leaving this at localhost on a
# deployed host silently breaks every verification email, so the boot guard
# rejects it.
FRONTEND_URL=http://localhost:3000

# CORS — JSON list of allowed origins. Plaintext http:// origins are rejected
# outside development: allow_credentials is on, so they are a credential-leak
# path (SAHA-010).
CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# KYC (Persona). Mock mode self-approves via /me/kyc/complete and makes the
# webhook signature check pass unconditionally — it is gated on
# APP_ENV=development, NOT on this flag alone, because the flag was true on the
# public deployment and let anyone self-verify (SAHA-004).
PERSONA_API_KEY=REPLACE_ME
PERSONA_WEBHOOK_SECRET=REPLACE_ME
PERSONA_TEMPLATE_ID=             # itmpl_... from the Persona dashboard
KYC_MOCK_MODE=true

# Stripe. Mock mode is development-only: it marks escrow funded with no money
# moving, and escrow funding is what releases the seller's vault to the buyer
# (SAHA-036). Outside development an unconfigured key is a hard error.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# DocuSign (REPLACE_ME / empty = mock signing).
# NOTE: signature recording is now dual-party and hash-bound regardless — see
# services/transactions.sign_contract (SAHA-008).
DOCUSIGN_ACCOUNT_ID=REPLACE_ME
DOCUSIGN_INTEGRATION_KEY=REPLACE_ME
DOCUSIGN_PRIVATE_KEY=REPLACE_ME

# ── Vault encryption (AES-256-GCM) ───────────────────────────────────────────
#
# V2 is the write key. V1 exists ONLY so objects encrypted before the rotation
# stay readable, and the value below is the exact placeholder that was found in
# production — treat anything wrapped under it as having been stored in
# cleartext.
#
# Generate with: openssl rand -base64 36
#
# Rotation:
#   1. set VAULT_ENCRYPTION_KEY_V2 and VAULT_V1_ROTATION_PENDING=true
#   2. uv run python scripts/rotate_vault_key.py --apply
#   3. clear VAULT_ENCRYPTION_KEY and set VAULT_V1_ROTATION_PENDING=false
#
# While the rotation is pending, every boot logs `security_action_outstanding` —
# a compromised key should not be able to quietly become permanent.
VAULT_ENCRYPTION_KEY=dev-vault-key-32-bytes-padding!!
VAULT_ENCRYPTION_KEY_V2=
VAULT_V1_ROTATION_PENDING=false
# Optional Matrix/Element E2EE transport (all five settings required).
# Use a dedicated keyless service account; never a personal account.
# See docs/ENCRYPTED-CHAT.md and docs/OPEN-COLLABORATION-DEPLOYMENT.md.
MATRIX_HOMESERVER_URL=
MATRIX_SERVER_NAME=
MATRIX_SERVICE_USER_ID=
MATRIX_SERVICE_ACCESS_TOKEN=
ELEMENT_WEB_URL=
