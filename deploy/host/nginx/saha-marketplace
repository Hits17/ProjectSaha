server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name sahasolutions.com www.sahasolutions.com _;
    client_max_body_size 60M;
    access_log /var/log/nginx/saha-access.log saha_access;

    location = /api/v1/notifications/stream {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/saha-proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 75s;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/saha-proxy-headers.conf;
        proxy_read_timeout 120s;
        proxy_cache off;
    }
    location /health {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/saha-proxy-headers.conf;
        proxy_cache off;
    }
    location /metrics { deny all; }
    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/saha-proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $saha_connection_upgrade;
    }
}
